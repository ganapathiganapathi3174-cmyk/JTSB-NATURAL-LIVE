rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users_new collection - app's primary user collection
    match /users_new/{userId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow write: if request.auth != null;
      allow delete: if request.auth != null;
    }
    
    // Referrals_new collection - app's referral records
    match /referrals_new/{referralId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Legacy users collection
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == resource.data.firebase_uid;
      allow create: if request.auth != null;
    }
    
    // Legacy referrals collection
    match /referrals/{referralId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Payments collection
    match /payments/{paymentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Admins collection
    match /admins/{adminId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
