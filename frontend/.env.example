# ==================== Multi-Cloud Databases ====================

# Supabase (Primary Database — users, referrals, sponsors, wallets, topups, chat)
# https://supabase.com/dashboard/project/PROJECT_ID/settings/api
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Turso (Backup Database — critical backups, daily snapshots, user backups)
# https://turso.tech → Create database → Get URL and auth token
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Neon (Analytics Database — verification logs, payment logs, audit logs)
# https://console.neon.tech → Create project → Get connection string
NEON_DATABASE_URL=postgres://user:pass@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Cloudflare R2 (File Storage — payment screenshots, profile pictures, documents)
# https://dash.cloudflare.com → R2 → Create bucket → Get API tokens
R2_ENDPOINT=https://xxxx.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET=jtsb-payments
R2_PUBLIC_DOMAIN=pub-xxxx.r2.dev

# ==================== Frontend Config ====================
