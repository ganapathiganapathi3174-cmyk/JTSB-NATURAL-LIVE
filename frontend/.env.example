# UPI Payment Configuration
VITE_PAYMENT_AMOUNT=120
VITE_UPI_VPA=jayarajj126-3@okicici
VITE_UPI_PAYEE_NAME=Community

# JWT Secrets (optional - will use defaults if not set)
# VITE_JWT_SECRET=your-secret-key-here
# VITE_ADMIN_JWT_SECRET=your-admin-secret-key-here

# Admin Login (optional - will use defaults if not set)
# VITE_ADMIN_EMAIL=admin@example.com
# VITE_ADMIN_PASSWORD=your-admin-password

# Firebase Configuration (REQUIRED for production)
# Get these from: https://console.firebase.google.com/
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id

# Razorpay Configuration (REQUIRED — set LIVE key for production)
VITE_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx

# Firebase Cloud Functions URL
# Development: /api (uses Vite proxy to Firebase emulator)
# Production: https://us-central1-PROJECT_ID.cloudfunctions.net
VITE_FUNCTIONS_URL=/api

# Google Cloud Vision API (optional — cross-validate OCR with Google Vision)
# Get key from: https://console.cloud.google.com/apis/credentials (restrict by HTTP referrer)
# VITE_GOOGLE_VISION_API_KEY=your-vision-api-key
