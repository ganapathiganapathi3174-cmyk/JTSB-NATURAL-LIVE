rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - users can read/update their own data
    match /users/{userId} {
      allow read: if true;  // Public read for referral verification
      allow write: if request.auth != null && request.auth.uid == resource.data.firebase_uid;
      allow create: if request.auth != null;
    }
    
    // Referrals collection
    match /referrals/{referralId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Payments collection
    match /payments/{paymentId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Admins collection
    match /admins/{adminId} {
      allow read: if true;
      allow write: if false;  // Only server-side
    }
  }
}
